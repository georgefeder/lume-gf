@@ -616,6 +621,11 @@ extension MEPlayerItem: MediaPlayback {
             guard let self else { return }
             Thread.current.name = (self.operationQueue.name ?? "") + "_open"
             Thread.current.stackSize = KSOptions.stackSize
+            // Lume GF: one connection at a time — the replaced item closes its input first (at most 1.5 s)
+            if let replaced = self.replacedItem {
