--- a/Sources/KSPlayer/MEPlayer/KSMEPlayer.swift
+++ b/Sources/KSPlayer/MEPlayer/KSMEPlayer.swift
@@ -316,9 +316,12 @@ extension KSMEPlayer: MediaPlayerProtocol {
 
     public func replace(url: URL, options: KSOptions) {
         KSLog("replaceUrl \(self)")
+        // Lume GF: the next item opens only after this one has closed its input
+        let replaced = playerItem
         shutdown()
         playerItem.delegate = nil
         playerItem = MEPlayerItem(url: url, options: options)
+        playerItem.replacedItem = replaced
         if options.videoDisable {
             videoOutput = nil
         } else if videoOutput == nil {
