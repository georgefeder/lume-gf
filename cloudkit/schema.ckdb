DEFINE SCHEMA

    RECORD TYPE CD_SyncedPlaylist (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_id STRING,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_serverURL STRING,
        CD_serverURL_ckAsset ASSET,
        CD_username ENCRYPTED STRING,
        CD_username_ckAsset ASSET,
        CD_password ENCRYPTED STRING,
        CD_password_ckAsset ASSET,
        CD_macAddress ENCRYPTED STRING,
        CD_macAddress_ckAsset ASSET,
        CD_sourceTypeRaw STRING,
        CD_sourceTypeRaw_ckAsset ASSET,
        CD_epgURL STRING,
        CD_epgURL_ckAsset ASSET,
        CD_syncEnabled INT64,
        CD_hiddenTabsRaw STRING,
        CD_hiddenTabsRaw_ckAsset ASSET,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserContentState (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_contentId STRING,
        CD_contentId_ckAsset ASSET,
        CD_kindRaw STRING,
        CD_kindRaw_ckAsset ASSET,
        CD_profileID STRING,
        CD_watchProgress DOUBLE,
        CD_isWatched INT64,
        CD_lastWatchedDate TIMESTAMP,
        CD_isFavorite INT64,
        CD_addedToWatchlistDate TIMESTAMP,
        CD_favoriteOrder INT64,
        CD_isHidden INT64,
        CD_customOrder INT64,
        CD_recommendationVoteRaw INT64,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_UserProfile (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_id STRING,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_symbolName STRING,
        CD_symbolName_ckAsset ASSET,
        CD_colorRaw STRING,
        CD_colorRaw_ckAsset ASSET,
        CD_createdAt TIMESTAMP,
        CD_sortOrder INT64,
        CD_updatedAt TIMESTAMP,
        CD_isChild INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SyncedEPGSource (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_id STRING,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_url STRING,
        CD_url_ckAsset ASSET,
        CD_isEnabled INT64,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SyncedParentalPIN (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_id STRING,
        CD_id_ckAsset ASSET,
        CD_pinHash STRING,
        CD_pinHash_ckAsset ASSET,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SyncedCategoryRestriction (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_categoryID STRING,
        CD_categoryID_ckAsset ASSET,
        CD_isRestricted INT64,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SyncedSportsFollow (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_key STRING,
        CD_key_ckAsset ASSET,
        CD_kindRaw STRING,
        CD_kindRaw_ckAsset ASSET,
        CD_profileID STRING,
        CD_sortOrder INT64,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SyncedRecordingServer (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        CD_entityName STRING QUERYABLE,
        CD_moveReceipt BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_id STRING,
        CD_kindRaw STRING,
        CD_kindRaw_ckAsset ASSET,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_baseURL STRING,
        CD_baseURL_ckAsset ASSET,
        CD_serverID STRING,
        CD_deviceID STRING,
        CD_token ENCRYPTED STRING,
        CD_token_ckAsset ASSET,
        CD_isEnabled INT64,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE GFLastPlayed (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE QUERYABLE,
        deviceID STRING,
        deviceKind STRING,
        kind STRING,
        contentId STRING,
        title STRING,
        artworkURL STRING,
        position DOUBLE,
        duration DOUBLE,
        playing INT64,
        updatedAt TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

