+++ b/Lume/Views/LiveTV/EPG/EPGFrozenPanes.swift
@@ -23,15 +23,25 @@ struct EPGRulerStrip: View {
     let sync: EPGScrollSync
 
     var body: some View {
+        let fade = GFGuideGlass.rulerFade(tv: GFGuideGlass.isTV)
         Color.clear
             .frame(maxWidth: .infinity)
             .frame(height: metrics.headerHeight)
+            .overlay(alignment: .leading) {
+                EPGTimeRuler(timeline: timeline, metrics: metrics)
+                    .frame(width: timeline.totalWidth, alignment: .leading)
+                    .offset(x: -sync.mirror.x)
+            }
+            .clipped()
+            // Lume GF: the times blur and fade out at the channel column's edge and the screen's; the Now pill, a
+            // layer of its own above them, stays sharp
+            .modifier(GFRulerEdgeBlur(leading: fade.leading, trailing: fade.trailing))
             .overlay(alignment: .leading) {
                 // Lume GF: the pill is an overlay; as a ZStack sibling its centring overhang widened the ruler and
                 // moved every time half a pill right of the grid
-                EPGTimeRuler(timeline: timeline, metrics: metrics)
+                Color.clear
+                    .frame(width: timeline.totalWidth, height: metrics.headerHeight)
                     .overlay(alignment: .topLeading) { nowPill.offset(x: timeline.x(for: now)) }
-                    .frame(width: timeline.totalWidth, alignment: .leading)
                     .offset(x: -sync.mirror.x)
             }
             .clipped()
