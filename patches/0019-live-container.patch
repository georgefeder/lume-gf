+    /// Lume GF: `url` in the other of the two interchangeable live containers (`.m3u8` and `.ts`), or nil when it is
+    /// not one of them. The player tries it once when a live stream will not start (`FullScreenPlayerView`).
+    static func gfOtherContainer(of url: URL) -> URL? {
+        guard var components = URLComponents(url: url, resolvingAgainstBaseURL: false),
+              let live = components.liveContainer
+        else { return nil }
+        let other: StreamFormat = live.format == .m3u8 ? .tsStream : .m3u8
+        components.path = String(live.stem) + "." + other.rawValue
