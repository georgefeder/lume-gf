+
+    /// Lume GF: an Xtream live URL (`…/live/<user>/<password>/<id>.m3u8` or `.ts`) in the other of the two
+    /// interchangeable containers, or nil for any other URL (an m3u's `video.m3u8`, a signed CDN address). The player
+    /// tries an HLS address once as TS when it will not start (`FullScreenPlayerView`).
+    static func gfOtherContainer(of url: URL) -> URL? {
+        let path = url.pathComponents
+        guard path.count >= 5, path[path.count - 4] == "live",
+              var components = URLComponents(url: url, resolvingAgainstBaseURL: false),
+              let live = components.liveContainer
+        else { return nil }
+        let other: StreamFormat = live.format == .m3u8 ? .tsStream : .m3u8
+        components.path = String(live.stem) + "." + other.rawValue
+        return components.url
+    }
 }
 
