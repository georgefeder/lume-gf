+                    GFCatchupHold.shared.keep(frame, for: next.id)
+                    onSelectMedia?(next)
+                }
+            }
+            // not started yet (a jump during a jump): the picture still held from before
+            guard hasStartedPlayback, gfDrawn, let player = coordinator.playerLayer?.player as? KSMEPlayer else {
+                open(zapFrame)
+                return true
+            }
+            Task { @MainActor in
