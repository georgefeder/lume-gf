+    }
+
+    func gfCatchupArrive() {
+        guard gfJumped, let window = media.gfCatchup else { return }
+        clock.current = window.offset
+        clock.duration = window.length
+        if let frame = GFCatchupHold.shared.take(for: media.id) { holdZapFrame(frame) }
+    }
 }
