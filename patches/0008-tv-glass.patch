+}
+
+/// Lume GF: neighbouring glass rendered together (`GlassEffectContainer` on OS 26+, a plain group before), so a column
+/// of glass tiles is sampled in one pass. `spacing` 0: tiles never melt into each other.
+struct GlassGroupCompat<Content: View>: View {
+    var spacing: CGFloat = 0
+    @ViewBuilder var content: Content
+
+    var body: some View {
+        if #available(iOS 26, tvOS 26, macOS 26, visionOS 26, *) {
+            GlassEffectContainer(spacing: spacing) { content }
+        } else {
+            content
+        }
+    }
 }
 
