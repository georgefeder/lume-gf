             }
         }
     }
@@ -50,6 +69,7 @@ private extension GlassEffectStyle {
         case .regularInteractive: .regular.interactive()
         case let .tintedInteractive(color): .regular.tint(color).interactive()
         case let .tinted(color): .regular.tint(color)
+        case .clear: .clear
         }
     }
 }
