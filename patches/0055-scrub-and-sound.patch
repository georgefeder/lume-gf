+    /// Lume GF: the sound back after an interruption. A voice message recorded with the player in picture in
+    /// picture stopped iOS's audio engine under it, and on play the picture came back without sound (Georgs, 19 Nov).
+    /// While playing: after an interruption the engine is started afresh (it may still say it runs), and an engine
+    /// found stopped (another app's audio set-up stops it too) is started again, at most every 5 s. Only for a stream
+    /// with sound: one without never starts the engine.
+    private func gfMendAudio() {
+        #if os(iOS)
+            // playable: while it buffers KSPlayer pauses the engine on purpose
+            guard hasStartedPlayback, let player = coordinator.playerLayer?.player, player.isPlaying,
+                  player.loadState == .playable,
+                  let output = (player as? KSMEPlayer)?.audioOutput as? AudioEnginePlayer
+            else { return }
+            let cut = tick.gfAudioCut
+            guard cut || !output.engine.isRunning, !player.tracks(mediaType: .audio).isEmpty else { return }
+            let now = CACurrentMediaTime()
+            guard now - tick.gfAudioMendAt >= 5 else { return }
+            tick.gfAudioMendAt = now
+            tick.gfAudioCut = false
+            try? AVAudioSession.sharedInstance().setActive(true)
+            if cut { output.engine.stop() }
+            output.play()
+            GFLiveLog.note("player: sound started again (\(cut ? "after an interruption" : "engine was stopped"), "
+                + "running: \(output.engine.isRunning))")
+        #endif
     }
 
