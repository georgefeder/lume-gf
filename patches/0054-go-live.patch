+    /// Lume GF: a live channel paused, or stalled, plays on from where it stopped, so it falls behind live by the
+    /// wall-clock time that passed beyond the time played (Georgs, 19 Nov: "a button ... to go back to the live").
+    /// Measured from a moment at live: the first picture of each open, moved up whenever the playhead runs ahead (a
+    /// buffer catching up) or jumps back (the stream's timestamps restarting).
+    private func gfNoteBehindLive(_ current: TimeInterval) {
+        guard media.isLive, hasStartedPlayback, current.isFinite else {
+            tick.gfLiveAnchor = nil
+            if clock.gfBehindLive != 0 { clock.gfBehindLive = 0 }
+            return
+        }
+        let now = CACurrentMediaTime()
+        guard let anchor = tick.gfLiveAnchor, anchor.media == media.id, current >= anchor.playhead,
+              current - anchor.playhead <= now - anchor.wall
+        else {
+            tick.gfLiveAnchor = (media.id, now, current)
+            if clock.gfBehindLive != 0 { clock.gfBehindLive = 0 }
+            return
+        }
+        let behind = (now - anchor.wall) - (current - anchor.playhead)
+        // close to live, the anchor moves up, so the player's clock running a touch slower than the wall's over
+        // hours never adds up to "behind"
+        if behind < 2 { tick.gfLiveAnchor = (media.id, now, current) }
+        let shown = behind < 5 ? 0 : behind.rounded(.down) // a moment's wobble is still live
+        if clock.gfBehindLive != shown { clock.gfBehindLive = shown }
+    }
+
+    /// Lume GF: the channel opens afresh at live (Go Live, a retry, a reconnect): measured anew from its first picture.
+    func gfBackAtLive() {
+        tick.gfLiveAnchor = nil
+        if clock.gfBehindLive != 0 { clock.gfBehindLive = 0 }
+        if clock.gfPausedAt != nil { clock.gfPausedAt = nil }
+    }
+
+    /// Lume GF: a live channel paused (by the viewer, a call, a voice message): the badge counts the pause as it goes.
+    func gfNotePause(_ state: KSPlayerState) {
+        guard media.isLive, hasStartedPlayback else { return }
+        if state == .paused {
+            if clock.gfPausedAt == nil { clock.gfPausedAt = Date() }
+        } else if clock.gfPausedAt != nil {
+            clock.gfPausedAt = nil
+        }
     }
 
