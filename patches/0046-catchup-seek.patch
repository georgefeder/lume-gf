+    /// Lume GF: the playing time for the position bar. A catch-up programme shows its own time (the minutes its
+    /// address skipped plus the time played) and its own length (GFCatchupSeek).
+    func gfTick(current: TimeInterval, total: TimeInterval) {
+        let window = gfPlaying.media?.gfCatchup
+        if current.isFinite { clock.current = current + (window?.offset ?? 0) }
+        if let window {
+            clock.duration = window.length
+        } else if total.isFinite, total > 0 {
+            clock.duration = total
+        }
+    }
+
+    /// Lume GF: a seek in a catch-up programme asks the archive again from that minute, as a new item, instead of
+    /// seeking inside a file the provider can't seek in (GFCatchupSeek). `false` for anything else.
+    func gfCatchupJump(_ jump: GFCatchupSeek.Jump) -> Bool {
+        guard let playing = gfPlaying.media, let window = playing.gfCatchup else { return false }
+        if let offset = GFCatchupSeek.offset(for: jump, current: clock.current, in: window),
+           let next = playing.gfCatchupShifted(to: offset) {
+            mediaSwapper.swap { selectMedia(next) }
+        }
+        return true
+    }
 }
