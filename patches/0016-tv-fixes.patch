+    /// Lume GF: black over the video surface until the stream on it has drawn a frame. A new stream's surface can show
+    /// leftover image memory first; surfing fast (the channel before never started, so no frame is held) flashed
+    /// fragments of other screens (Georgs, 11 Oct: a shrunken piece of the Live TV list while a channel loaded).
+    /// Shown at most a second past the stream's start, should its playhead not move (a paused start).
+    @ViewBuilder
+    var gfUndrawnCover: some View {
+        if !gfDrawn {
+            Color.black
+                .ignoresSafeArea()
+                .allowsHitTesting(false)
+                .accessibilityHidden(true)
+                .task(id: hasStartedPlayback) {
+                    guard hasStartedPlayback else { return }
+                    try? await Task.sleep(for: .seconds(1))
+                    if !Task.isCancelled { gfDrawn = true }
+                }
+        }
+    }
