+    /// Lume GF: how much video is buffered ahead 10 s after the first picture, for the server (GFPlayBeacon).
+    private func gfReportBuffer() {
+        guard media.isLive else { return }
+        let id = media.id
+        Task { @MainActor [weak coordinator] in
+            try? await Task.sleep(for: .seconds(10))
+            guard gfPlaying.media?.id == id, let player = coordinator?.playerLayer?.player else { return }
+            let ahead = player.playableTime - player.currentPlaybackTime
+            if ahead.isFinite, ahead >= 0 { GFPlayBeacon.send(.buffer(seconds: ahead)) }
+        }
     }
 
